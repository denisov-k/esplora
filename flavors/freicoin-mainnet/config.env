#!/bin/bash

export SITE_TITLE='Freicoin Explorer'
export HOME_TITLE='Freicoin Explorer'
export SITE_DESC='Freicoin block explorer, demurrage-aware'
export SITE_FOOTER='Freicoin Explorer, built on Esplora (MIT)'
export NATIVE_ASSET_LABEL=FRC
export NATIVE_ASSET_NAME=Freicoin
export TARGET_BLOCK_INTERVAL_SECONDS=900
export BASE_HREF=${BASE_HREF:-'/explorer/'}
export FEE_RATE_UNIT='kria/vB'
export HIDE_SEGWIT_GAINS=1

export MIN_FEE_RATE=1
export CUSTOM_CSS="$CUSTOM_CSS flavors/freicoin-mainnet/extras.css"
export HIDE_BITCOIN_PRICE=1
export FREICOIN=1
export CUSTOM_ASSETS="$CUSTOM_ASSETS flavors/freicoin-mainnet/www/*"
export FAVICON=img/favicon.svg
export FAVICON_TYPE=image/svg+xml
export HEAD_HTML='<script src="js/theme.js"></script>'
export THEMES=1
